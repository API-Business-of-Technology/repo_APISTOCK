{
  "name": "backend_apistock",
  "version": "1.0.0",
  "description": "Backend du logiciel APISTOCK.",
  "keywords": [
    "stock",
    "reseau",
    "Stock",
    "lojistik"
  ],
  "homepage": "https://gitlab.com/apibusinesstechnology-group/repo_apistock#readme",
  "bugs": {
    "url": "https://gitlab.com/apibusinesstechnology-group/repo_apistock/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/apibusinesstechnology-group/repo_apistock.git"
  },
  "license": "SEE LICENSE IN LICENSE.txt",
  "author": "Pierre Richard Saint Louis-API Business Technology",
  "type": "module",
  "main": "server.js",
  "scripts": {
     "start": "node server.js",
     "dev": "nodemon server.js",
     "lint": "eslint . --ext .js,.ts,.tsx --fix",
     "format": "prettier --write .",
     "test": "jest --config jest.config.cjs --passWithNoTests",
     "test:unit": "jest --runTestsByPath tests/unit --passWithNoTests",
     "test:integration": "jest --runTestsByPath tests/integration --passWithNoTests",
     "test:e2e": "jest --runTestsByPath tests/e2e --passWithNoTests",
     "test:coverage": "jest --coverage",
     "mutate": "stryker run",
     "sonar": "sonar-scanner",
     "prepare": "husky install",
     "test:all": "npm run test && npm run test:unit && npm run test:integration && npm run test:e2e && npm run test:coverage"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^8.0.5",
    "@babel/preset-typescript": "^8.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/jest-runner": "^10.0.0",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^7.2.1",
    "babel-jest": "^30.5.1",
    "jest": "^30.5.1",
    "jest-environment-node": "^30.5.1",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
